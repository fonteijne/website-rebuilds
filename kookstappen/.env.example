# Verplicht: API-key van https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Optioneel: welk model OpenRouter gebruikt (moet afbeeldingen kunnen lezen)
OPENROUTER_MODEL=google/gemini-3.8-flash
# Optioneel: hoeveel het model "nadenkt" (none, low, medium, high). low = snel en goedkoop.
OPENROUTER_REASONING=low
# Optioneel: toegangscode, zodat niet iedereen met de link jouw OpenRouter-tegoed gebruikt
ACCESS_CODE=
